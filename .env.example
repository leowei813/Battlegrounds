# 雲端存檔後端（建置時讀取，複製為 .env 後修改）
#   selfhost  使用專案內建的 server/（預設，API 走同網域 /api）
#   supabase  使用 Supabase（需先執行 supabase/schema.sql）
#   none      關閉雲端存檔
VITE_CLOUD_PROVIDER=selfhost

# 自架伺服器網址；前端與伺服器同網域時留空
VITE_CLOUD_URL=

# Supabase 設定（Project Settings → API）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
